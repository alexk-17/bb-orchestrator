{
  "name": "bb-plugin-orchestrator",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "description": "Orchestration for bb: roles, decisions, mail and the Steward, in one plugin.",
  "bin": {
    "cloud": "./cloud/bin/cloud"
  },
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Orchestrator",
    "description": "Roles (CoS, Steward, leads, threads), decisions for you, mail between agents, and the Steward's host alarms.",
    "branding": {
      "icon": "Workflow"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.ts cloud/test/*.test.ts gameboy/test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bb plugin build"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "1.59.1",
    "typescript": "^5.7.0"
  }
}
